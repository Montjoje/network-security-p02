        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TD\n    %% Definicje węzłów i sieci\n    CLIENT[\&quot;💻 Klient testowy&lt;br&gt;192.168.10.10\&quot;]\n    ROUTER((\&quot;🌐 Router&lt;br&gt;(3 interfejsy)\&quot;))\n\n    subgraph CLIENT_NET [\&quot;CLIENT-NET (192.168.10.0/24)\&quot;]\n        CLIENT\n    end\n\n    subgraph DMZ [\&quot;DMZ (192.168.20.0/24)\&quot;]\n        subgraph APP_SRV [\&quot;APP-SRV (192.168.20.10)\&quot;]\n            WAF[\&quot;🛡️ Nginx + ModSecurity WAF\&quot;]\n            FLASK[\&quot;⚙️ Aplikacja Flask\&quot;]\n            APP_LOGS[/\&quot;🗄️ Logi (WAF, Nginx, Audit)\&quot;/]\n            WAF --&gt; FLASK\n            WAF -.-&gt; APP_LOGS\n        end\n    end\n\n    subgraph DB_NET [\&quot;DB-NET (192.168.30.0/24)\&quot;]\n        subgraph DB_SRV [\&quot;DB-SRV (192.168.30.10)\&quot;]\n            DB[\&quot;🐘 PostgreSQL\&quot;]\n            DB_LOGS[/\&quot;🗄️ Logi (PostgreSQL, Audit)\&quot;/]\n            DB -.-&gt; DB_LOGS\n        end\n    end\n\n    %% Relacje, ruch i blokady\n    CLIENT_NET -- \&quot;✅ HTTPS (TCP/443)\&quot; --&gt; ROUTER\n    CLIENT_NET -- \&quot;❌ BLOKADA SSH (TCP/22)\&quot; -.-x ROUTER\n    ROUTER --&gt; APP_SRV\n    APP_SRV -- \&quot;✅ PostgreSQL (TCP/5432)\&quot; --&gt; DB_SRV&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="5LuKprxFAJi7RFLy_rgm-1">
